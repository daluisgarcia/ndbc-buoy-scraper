# Local development environment. Copy and edit:
#
#     cp .env.example .env
#
# .env is gitignored. For the SERVER, do not use this file -- use
# deploy/pipeline.env.example, which systemd loads via EnvironmentFile.
#
# WHO READS THIS FILE
#
#   Docker Compose reads ./.env automatically, but ONLY the POSTGRES_* names
#   below are interpolated into docker-compose.yml.
#
#   The Python stages (scrapy, silver, healthcheck) read the real process
#   environment. This project has NO python-dotenv dependency, so `make scrape`
#   will NOT see anything in this file on its own. Export it first:
#
#       set -a; . ./.env; set +a
#       make pipeline
#
#   Every variable here has a working default in code, except NDBC_CONTACT.
#   An empty .env yields a functioning local dev setup.

# --- Postgres: what the Python stages CONNECT to and the container uses ---------------------------
# Read by ndbc_buoy_scraper/pg.py. Host is localhost because compose publishes
PG_HOST=localhost
PG_PORT=5432
PG_USER=ndbc
PG_PASSWORD=ndbc
PG_DB=ndbc

# --- Crawl behaviour -------------------------------------------------------
# REQUIRED. Goes into the User-Agent so NOAA can contact you instead of just
# blocking the client. The code default is a placeholder, not a valid address.
NDBC_CONTACT=you@example.com

# Re-download every historical year instead of only the changed ones. Enabled
# by 1/true/yes; unset means incremental. Turns a ~1,350-request run into
# ~17,000, so leave it off for day-to-day work.
# NDBC_FULL_REFRESH=1

# Record each run in the pipeline_runs table. Disabled by 0/false/no. Worth
# turning off only when running against no database at all.
# TRACK_RUNS=1

# --- Paths -----------------------------------------------------------------
# Bronze parquet output; read by BOTH the spider and the silver job, which is
# how silver finds what scrape produced. Change it in one place only.
BRONZE_ROOT=data/bronze

# DuckDB spill directory for the silver job. Needs room for large sorts.
DUCKDB_TEMP_DIR=data/tmp

# --- Resource caps ---------------------------------------------------------
# Left unset, DuckDB claims ~80% of system RAM and starves the Postgres it is
# loading into. The values below are the 4 vCPU / 6 GB production budget; on a
# development machine with more headroom you can raise them.
DUCKDB_MEMORY_LIMIT=1500MB
DUCKDB_THREADS=3

# Scrapy aborts the crawl past the limit and logs a warning at the lower mark.
SCRAPY_MEMUSAGE_LIMIT_MB=1200
SCRAPY_MEMUSAGE_WARNING_MB=900

# --- Silver job ------------------------------------------------------------
# Rebuild every year partition regardless of bronze fingerprint. Enabled by
# 1/true/yes. Normally unset: only changed years get rebuilt.
# SILVER_FORCE=1

# --- Monitoring ------------------------------------------------------------
# Freshness threshold for `make health`. Past this age, at least one full daily
# cycle produced nothing and the check exits non-zero.
HEALTH_MAX_AGE_HOURS=36

# A run still marked 'running' after this long means the process died without
# unwinding -- OOM kill, SIGKILL, power loss.
HEALTH_STALE_RUN_HOURS=12

LOG_LEVEL=INFO

# --- Alerting (server only) ------------------------------------------------
# Read by deploy/ndbc-alert@.service, not by any Python code. Any endpoint
# accepting a JSON {"text": "..."} POST (Slack, Discord, ntfy, Gotify).
# Unset means journal-only alerting.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...